[Unit]
Description=SandboxJS API Server (control plane)
After=network.target

[Service]
Type=simple
User=root
WorkingDirectory=/opt/sandboxjs/app
ExecStartPre=/usr/bin/mkdir -p /opt/sandboxjs/data
ExecStart=/usr/bin/node dist/server.js
EnvironmentFile=/etc/sandboxjs.env
Environment=NODE_ENV=production
Environment=PORT=3000
Environment=HOST=0.0.0.0
Environment=TIMEOUT_MS=5000
Environment=MAX_SANDBOXES=17
Environment=SANDBOX_TTL_MS=300000
Environment=DATABASE_PATH=/opt/sandboxjs/data/sandboxjs.db
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target

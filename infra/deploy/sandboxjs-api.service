[Unit]
Description=SandboxJS API Server
After=network.target

[Service]
Type=simple
User=root
WorkingDirectory=/opt/sandboxjs/app
ExecStart=/usr/bin/node dist/server.js
Environment=NODE_ENV=production
Environment=SANDBOX_BACKEND=firecracker
Environment=PORT=3000
Environment=HOST=0.0.0.0
Environment=TIMEOUT_MS=5000
Environment=MAX_MEMORY_MB=256
Environment=SANDBOX_TTL_MS=300000
Environment=KERNEL_IMAGE_PATH=/opt/sandboxjs/vmlinux
Environment=ROOTFS_PATH=/opt/sandboxjs/rootfs.ext4
Environment=FIRECRACKER_BIN=/usr/local/bin/firecracker
Environment=JAILER_BIN=/usr/local/bin/jailer
Environment=JAILER_UID=1000
Environment=JAILER_GID=1000
Environment=CPU_QUOTA_PERCENT=50
Environment=CHROOT_BASE_DIR=/srv/jailer
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target

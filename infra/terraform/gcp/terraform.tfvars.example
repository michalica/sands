project_id = "your-gcp-project-id"

# Defaults below — uncomment to override.

# region                  = "europe-west3"      # Frankfurt
# zone                    = "europe-west3-a"
# instance_name           = "sandboxjs"
# api_machine_type        = "e2-small"          # control plane, no nested virt
# worker_machine_type     = "n2-standard-2"     # nested virt required
# worker_count            = 1
# api_boot_disk_size_gb   = 20
# worker_boot_disk_size_gb = 30
# ssh_user                = "ubuntu"
# ssh_pubkey_path         = "~/.ssh/id_ed25519.pub"

# Restrict API + SSH access. Find your IP: curl -4 ifconfig.me
# api_allowed_cidrs = ["1.2.3.4/32"]
